    DriveBtn.TextColor3 = AZHub.Toggled.AutoDrive and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 255, 255)
end)

RollBtn.MouseButton1Click:Connect(function()
    AZHub.Toggled.AutoRoll = not AZHub.Toggled.AutoRoll
    RollBtn.Text = "Auto Roll / Upgrade: " .. (AZHub.Toggled.AutoRoll and "ON" or "OFF")
    RollBtn.TextColor3 = AZHub.Toggled.AutoRoll and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 255, 255)
end)

